# Copy this file to .env.local for local development and fill in values.
# .env.local is gitignored — never commit real secrets.

# NextAuth
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Site-wide demo gate (optional). Leave unset for local dev — the app
# works normally with no extra prompt. Set this in Vercel's production
# environment variables before going live so the whole app (including
# the demo login list) sits behind one shared HTTP Basic Auth password.
# SITE_ACCESS_PASSWORD=choose-a-password

# --- Production target (Supabase + Vercel) ---
# Not wired up yet — current app runs on local SQLite. These will be
# needed when the Postgres/Supabase Auth migration in the architecture
# doc's "Pre-deployment checklist" actually starts.
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
