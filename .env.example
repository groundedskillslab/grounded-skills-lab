# Copy this file to .env.local for local development and fill in values.
# .env.local is gitignored — never commit real secrets.

# Site-wide demo gate (optional, currently OFF in production). Leave unset
# for local dev and for real production use — the app works normally with
# no extra prompt. This existed only for the shared-password demo-account
# period; middleware.ts still has the HTTP Basic Auth check, so setting
# this again re-enables it (e.g. for a future private beta) with no code
# changes needed.
# SITE_ACCESS_PASSWORD=choose-a-password

# Gate for /admin/beta-signups (see middleware.ts's adminAccessOk). REQUIRED
# in production if you want that page reachable at all — unlike
# SITE_ACCESS_PASSWORD above, leaving this unset BLOCKS the route rather
# than opening it, since it lists real signup names/emails. Set this in
# Vercel's production env vars once you're ready to use the admin page;
# leave it unset locally unless you're testing that page specifically.
# ADMIN_PASSWORD=choose-a-different-password

# --- Email (beta signup notifications) ---
# Sends a notification email whenever someone submits the beta-access form
# (src/actions/beta.ts / src/lib/email.ts). Uses Resend rather than your
# personal Gmail — the server needs to send mail on its own, not as you.
# Leave RESEND_API_KEY unset to skip sending entirely (signups still save
# to the database and show up in /admin/beta-signups either way).
#
# 1. Sign up free at resend.com and grab an API key from the dashboard.
# 2. Verify groundedskillslab.com as a sending domain there (it'll give
#    you SPF/DKIM TXT records to add in Namecheap's Advanced DNS — same
#    panel used for the hello@ setup). Until verified, you can only send
#    from Resend's own onboarding@resend.dev address, which is fine for
#    testing but not for production.
# RESEND_API_KEY=
# Defaults to hello@groundedskillslab.com if unset.
# BETA_SIGNUP_NOTIFY_EMAIL=hello@groundedskillslab.com
# Must be an address on a domain verified with Resend (step 2 above).
# Defaults to Resend's shared testing address if unset.
# BETA_SIGNUP_FROM_EMAIL=Grounded Skills Lab <notifications@groundedskillslab.com>

# --- Supabase (database + auth) ---
# For this project's Supabase instance, the Session Pooler connection
# string is the one confirmed IPv4-safe (Transaction Pooler defaults to
# IPv6 here, which broke Vercel's build) — use the Session Pooler string
# for both local dev and Vercel's DATABASE_URL. Get it from Supabase:
# Project Settings -> Database -> Connect -> Session pooler.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Admin key — needed locally to run `npm run auth:link`, AND now needed in
# Vercel's production environment too: the "Invite Someone" flow
# (src/actions/team.ts) calls the Supabase Auth admin API server-side to
# send real invite emails. Never expose this to the browser or commit it.
# Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
