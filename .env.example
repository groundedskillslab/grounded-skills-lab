# Copy this file to .env.local for local development and fill in values.
# .env.local is gitignored — never commit real secrets.

# Site-wide demo gate (optional). Leave unset for local dev — the app
# works normally with no extra prompt. Set this in Vercel's production
# environment variables before going live so the whole app (including
# the demo login list) sits behind one shared HTTP Basic Auth password.
# SITE_ACCESS_PASSWORD=choose-a-password

# --- Supabase (database + auth) ---
# Session pooler for local dev / running migrations (persistent connection).
# Vercel's production deploy should use the Transaction Pooler string instead.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Admin key — only needed locally to run `npm run auth:link`. Never expose
# this to the browser or commit it. Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
